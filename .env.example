# Central de Decisões LORLER — exemplo de configuração (somente placeholders)
# Copie para .env e preencha. NUNCA versione o .env nem cole valores secretos no chat.

LORLER_ENV=development
PORT=3700
HOST=127.0.0.1
# LORLER_DB_FILE=./data/lorler.db

# Dados de demonstração (identificados na tela). Em produção: false
LORLER_DEMO_MODE=true
# Em produção atrás de HTTPS: true
LORLER_COOKIE_SECURE=false
LORLER_SESSION_HOURS=12
LORLER_REAUTH_MINUTES=15
LORLER_WORKER_IN_PROCESS=true

# Provedor de IA: demo | openai | anthropic
LORLER_AI_PROVIDER=demo
# Modelo padrão (consulte a documentação oficial vigente antes de escolher)
LORLER_AI_MODEL=
# Modelo por agente (opcional)
LORLER_AI_MODEL_COORDINATOR=
LORLER_AI_MODEL_FINANCIAL=
LORLER_AI_MODEL_COMMERCIAL=
LORLER_AI_MODEL_OPERATIONS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Conectores dos produtos (somente HTTPS e hosts listados)
LORLER_CONNECTOR_ALLOWED_HOSTS=
# Credenciais de leitura (cada integração referencia uma destas variáveis por secret_ref)
LORLER_SECRET_ORBI=
LORLER_SECRET_TORVEN=
LORLER_SECRET_RUSTEN=
LORLER_SECRET_APOLVEN=
# Somente desenvolvimento: permitir http://localhost para testar um produto local
LORLER_CONNECTOR_ALLOW_LOCALHOST=false

# Eventos externos (n8n etc.) assinados por HMAC
LORLER_EVENTS_HMAC_SECRET=

# Instagram (Agente de Marketing) — ver docs/INSTAGRAM.md
# Login pelo Instagram (opcional; sem isso use "Colar token de acesso" no painel)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Precisa ser HTTPS e estar cadastrada no app da Meta, ex.: https://cerebro.lorler.com.br/api/social/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Versão da Graph API (confira a vigente na documentação da Meta)
INSTAGRAM_API_VERSION=v24.0
LORLER_AI_MODEL_MARKETING=

# Chave (32 bytes em base64) para criptografar tokens no banco. Se vazia, é gerada em data/lorler.key
LORLER_ENCRYPTION_KEY=

# Endereço público (preenchido pelo PUBLICAR-CEREBRO.bat), ex.: https://cerebro.lorler.com.br
LORLER_PUBLIC_URL=
# Atrás do Cloudflare Tunnel: usar o IP real do visitante (CF-Connecting-IP)
LORLER_TRUST_PROXY=false

# Área Master (ver docs/AREA-MASTER.md) — use um administrador dedicado ao cérebro
LORLER_MASTER_URL=
LORLER_MASTER_USERNAME=
LORLER_SECRET_MASTER_PASSWORD=
# Somente se o administrador tiver MFA (segredo TOTP em base32)
LORLER_SECRET_MASTER_TOTP=

# WhatsApp Business Cloud API (ver docs/WHATSAPP.md)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
LORLER_SECRET_WHATSAPP_TOKEN=
LORLER_SECRET_WHATSAPP_APP_SECRET=
LORLER_SECRET_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# Modelo aprovado (corpo com 3 variáveis: {{1}} título, {{2}} ação, {{3}} código) para avisar fora da janela de 24 h
WHATSAPP_TEMPLATE_APPROVAL=
WHATSAPP_TEMPLATE_LANG=pt_BR
